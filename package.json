{
  "name": "journeyman-exam-florida",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f docker/docker-compose.yml up -d && npm run dev --workspace apps/web",
    "db:migrate": "npm run prisma:migrate --workspace packages/db",
    "db:seed": "npm run seed --workspace packages/db",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "npm run test --workspace apps/web"
  }
}
